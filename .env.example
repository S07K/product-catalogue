# Copy to .env for local overrides. Every value below has a working local default,
# so `docker compose up` runs without creating this file.

# ---------- API ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origin allowed by CORS when running the web dev server separately (npm run dev).
WEB_ORIGIN=http://localhost:5173

# Product data source: fakestore | fixture
#   fakestore -> live Fake Store API (https://fakestoreapi.com), cached in memory
#   fixture   -> bundled sample data; works offline
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000

# Curated "top rated" products (owner-maintained config)
FEATURED_CONFIG_PATH=./data/featured.json

# ---------- Email ----------
# Email provider: smtp | console
#   smtp    -> any SMTP server. Locally this is Mailpit (dev-only inbox at http://localhost:8025).
#              In production point SMTP_* at a real provider (e.g. AWS SES SMTP, SendGrid, Postmark).
#   console -> logs the email instead of sending it (useful without Docker)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Product Catalogue <no-reply@catalogue.local>"
SALES_INBOX=sales@catalogue.local

# Enquiry rate limit per IP
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
